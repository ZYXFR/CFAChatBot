OPENAI_API_KEY=your_openai_api_key_here
# Optional: max tokens for chat completions (default 2500; lower if you hit rate/cost limits)
# OPENAI_MAX_COMPLETION_TOKENS=2500

# Events: reuse scraped homepage in-process for N minutes (default 360 = 6h)
# EVENTS_HOMEPAGE_CACHE_MINUTES=360

# Events: disk cache for LLM translation/enrichment per (data snapshot, language), in hours (default 168 = 7d)
# EVENTS_ENRICH_CACHE_TTL_HOURS=168
